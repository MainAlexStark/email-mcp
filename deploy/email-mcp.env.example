# deploy/email-mcp.env — права 600. Заполнить и НЕ коммитить.
# deploy.sh заполняет всё сам при первом развёртывании.

# Внешний адрес сервиса. На нём живут регистрация, кабинет, OAuth и /mcp.
MAIL_PUBLIC_URL=https://mail-mcp.example.com

# База. Пароль придумывает deploy.sh и кладёт его же в deploy/postgres.env.
MAIL_DATABASE_URL=postgres://mail:ПАРОЛЬ@postgres:5432/mail?sslmode=disable

# Мастер-ключ, которым шифруются пароли почтовых ящиков в базе.
# Сгенерировать: email-mcp --gen-secret
# ПОТЕРЯ КЛЮЧА = все пользователи подключают ящики заново.
# Храните копию отдельно от резервных копий базы: вместе они
# раскрывают пароли всех ящиков.
MAIL_SECRET_KEY=

# Регистрация:
#   open    — любой может завести учётную запись
#   invite  — только по приглашению (./deploy.sh invite)
#   closed  — новые не создаются, существующие работают
MAIL_REGISTRATION=open

# --- Пороги защиты ---
# Писем за одну операцию изменения (перенос, удаление, флаги).
MAIL_MAX_ITEMS_PER_WRITE=100
# Получателей письма без подтверждения confirm_many_recipients.
MAIL_MAX_RECIPIENTS=10
MAIL_MAX_RESPONSE_BYTES=40000

# --- Почтовые серверы ---
# Потолок одной операции с IMAP/SMTP.
# MAIL_TIMEOUT=2m
# Соединений на поиск по всем папкам (1–8).
# MAIL_IMAP_SEARCH_CONCURRENCY=4
# Разрешить ящики на внутренних адресах и без TLS — только если почтовый
# сервер стоит в той же сети. Иначе проверка ящика становится способом
# сканировать сеть сервиса.
# MAIL_ALLOW_PRIVATE_HOSTS=false

# SOCKS5-прокси для IMAP/SMTP — если провайдер недоступен напрямую
# (например Gmail с сервера в России). Действует только на почтовый трафик.
# MAIL_PROXY=socks5://user:pass@proxy.example.com:1080

# --- Вложения ---
# Сколько живёт ссылка на скачанное вложение. Файлы хранятся только
# в памяти процесса и пропадают при перезапуске.
# MAIL_FILES_TTL=1h
